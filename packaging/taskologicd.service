[Unit]
Description=Taskologic daemon
After=network.target

[Service]
Type=simple
User=taskologic
Group=taskologic
ExecStart=/usr/local/bin/taskologicd
Restart=on-failure
RestartSec=2

# /run/taskologic for the socket, /var/lib/taskologic for the database. Group members need to reach the socket, nobody but the daemon needs the db.
RuntimeDirectory=taskologic
RuntimeDirectoryMode=0755
StateDirectory=taskologic
StateDirectoryMode=0700
ConfigurationDirectory=taskologic

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
